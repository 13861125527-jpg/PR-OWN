          {
            "finding_occurrence_id": "4a53f537816c413e87c58bf78006f208",
            "title": "path containment check result discarded; process returns unvalidated path string",
            "category": "security",
            "path": "src/case_12.py",
            "start_line": 4,
            "end_line": 4,
            "trigger_condition": "Any caller relying on the return value of process() to be the resolved, contained path (e.g. value containing '..' or symlink components).",
            "impact": "",
            "explanation": "The tuple expression `(check(value), '/srv/data/' + value)[1]` still evaluates `check(value)`, so escape attempts still raise ValueError, but the validated/resolved `Path` returned by `check` is discarded. `process` now returns the raw, unnormalized string `/srv/data/` + value instead of the resolved target. This violates the helper's containment contract and reintroduces unnormalized segments (`..`, symlinks) into the returned path, which downstream consumers may treat as already validated. It also silently changes the return type from `Path` to `str`.",
            "suggestion": "Return the validated result directly: `return check(value)`. If a string is required, return `str(check(value))` so the value is the resolved, checked path."
          }
        ],
        "all_findings": [
